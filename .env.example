# URL del Worker de Cloudflare que sirve la IA (generar recetas y leer facturas).
# Sin esto la app funciona completa, solo que esas dos pantallas avisan que no están
# disponibles: todo lo demás es offline y no depende de red.
#
# Se obtiene al desplegar: cd worker && npx wrangler deploy
EXPO_PUBLIC_WORKER_URL=https://cocina-a-mano.camiloarinconc.workers.dev
